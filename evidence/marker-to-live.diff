diff --git a/programs/launchpad_program/src/instructions/claim_shared_meteora_fees.rs b/programs/launchpad_program/src/instructions/claim_shared_meteora_fees.rs
new file mode 100644
index 0000000..a3e88e0
--- /dev/null
+++ b/programs/launchpad_program/src/instructions/claim_shared_meteora_fees.rs
@@ -0,0 +1,134 @@
+//! Claim actual creator-position LP fees into locked shareholder custody.
+use super::graduate_meteora::{METEORA_GRADUATION_SEED, POSITION_MINT_SEED};
+use crate::{
+    constants::*,
+    errors::LaunchpadError,
+    meteora_cpi as damm,
+    state::{LaunchedCoin, MeteoraGraduation},
+};
+use anchor_lang::prelude::*;
+use anchor_spl::token::Token;
+use anchor_spl::token_2022::Token2022;
+use anchor_spl::token_interface::{Mint, TokenAccount};
+
+#[derive(Accounts)]
+pub struct ClaimSharedMeteoraFees<'info> {
+    /// CHECK: the immutable receipt binds this destination. A signature is
+    /// optional and only permits withdrawing positive amounts below the minimum.
+    #[account(address = graduation.creator_fee_recipient
+        @ LaunchpadError::Unauthorized)]
+    pub recipient: UncheckedAccount<'info>,
+    #[account(seeds = [METEORA_GRADUATION_SEED, mint.key().as_ref()],
+        bump = graduation.bump, has_one = mint, has_one = pool)]
+    pub graduation: Box<Account<'info, MeteoraGraduation>>,
+    #[account(seeds = [LAUNCHED_COIN_SEED, mint.key().as_ref()],
+        bump = launched_coin.bump, has_one = mint)]
+    pub launched_coin: Box<Account<'info, LaunchedCoin>>,
+    #[account(owner = token_2022_program.key())]
+    pub mint: Box<InterfaceAccount<'info, Mint>>,
+    #[account(address = WSOL_MINT, owner = token_program.key())]
+    pub wsol_mint: Box<InterfaceAccount<'info, Mint>>,
+    /// CHECK: receipt binds pool; DAMM verifies its layout and vaults.
+    #[account(mut, owner = damm::ID)]
+    pub pool: UncheckedAccount<'info>,
+    /// CHECK: position pinned to immutable graduation receipt.
+    #[account(mut, owner = damm::ID, address = graduation.creator_position)]
+    pub position: UncheckedAccount<'info>,
+    /// CHECK: only this program can create the canonical role mint.
+    #[account(seeds = [POSITION_MINT_SEED, mint.key().as_ref(), b"creator"], bump)]
+    pub position_mint: UncheckedAccount<'info>,
+    #[account(seeds = [b"position_nft_account", position_mint.key().as_ref()],
+        bump, seeds::program = damm::ID,
+        token::mint = position_mint, token::authority = launched_coin,
+        token::token_program = token_2022_program,
+        constraint = position_nft_account.amount == 1 && position_nft_account.delegate.is_none())]
+    pub position_nft_account: Box<InterfaceAccount<'info, TokenAccount>>,
+    #[account(mut, associated_token::mint = mint, associated_token::authority = revenue,
+        associated_token::token_program = token_2022_program)]
+    pub token_a_account: Box<InterfaceAccount<'info, TokenAccount>>,
+    #[account(mut, associated_token::mint = wsol_mint, associated_token::authority = revenue,
+        associated_token::token_program = token_program)]
+    pub token_b_account: Box<InterfaceAccount<'info, TokenAccount>>,
+    /// CHECK: canonical DAMM vault, checked again by its claim instruction.
+    #[account(mut, seeds = [b"token_vault", mint.key().as_ref(), pool.key().as_ref()], bump, seeds::program = damm::ID)]
+    pub token_a_vault: UncheckedAccount<'info>,
+    /// CHECK: canonical DAMM vault.
+    #[account(mut, seeds = [b"token_vault", WSOL_MINT.as_ref(), pool.key().as_ref()], bump, seeds::program = damm::ID)]
+    pub token_b_vault: UncheckedAccount<'info>,
+    /// CHECK: canonical DAMM authority.
+    #[account(seeds = [b"pool_authority"], bump, seeds::program = damm::ID)]
+    pub pool_authority: UncheckedAccount<'info>,
+    /// CHECK: canonical DAMM event authority.
+    #[account(seeds = [b"__event_authority"], bump, seeds::program = damm::ID)]
+    pub event_authority: UncheckedAccount<'info>,
+    /// CHECK: exact executable DAMM program.
+    #[account(address = damm::ID, executable)]
+    pub meteora_program: UncheckedAccount<'info>,
+    #[account(seeds = [super::creator_revenue::REVENUE_SEED, mint.key().as_ref()], bump = revenue.bump,
+        has_one = mint, constraint = revenue.authority == graduation.creator_fee_recipient @ LaunchpadError::Unauthorized)]
+    pub revenue: Box<Account<'info, super::creator_revenue::CreatorRevenue>>,
+    pub token_program: Program<'info, Token>,
+    pub token_2022_program: Program<'info, Token2022>,
+}
+
+pub(crate) fn handler(ctx: Context<ClaimSharedMeteoraFees>) -> Result<()> {
+    let a = ctx.accounts;
+    require!(a.launched_coin.reserved[super::creator_revenue::REVENUE_LOCK_BYTE] == 1,
+        LaunchpadError::CreatorRevenueLocked);
+
+    super::graduate_meteora::validate_token_beneficiary(a.recipient.key())?;
+    let mint = a.mint.key();
+    let bump = [a.launched_coin.bump];
+    let seeds: &[&[u8]] = &[LAUNCHED_COIN_SEED, mint.as_ref(), &bump];
+    let before_a = a.token_a_account.amount;
+    let before_b = a.token_b_account.amount;
+    damm::ClaimPositionFee {
+        pool_authority: a.pool_authority.to_account_info(),
+        pool: a.pool.to_account_info(),
+        position: a.position.to_account_info(),
+        token_a_account: a.token_a_account.to_account_info(),
+        token_b_account: a.token_b_account.to_account_info(),
+        token_a_vault: a.token_a_vault.to_account_info(),
+        token_b_vault: a.token_b_vault.to_account_info(),
+        token_a_mint: a.mint.to_account_info(),
+        token_b_mint: a.wsol_mint.to_account_info(),
+        position_nft_account: a.position_nft_account.to_account_info(),
+        signer: a.launched_coin.to_account_info(),
+        token_a_program: a.token_2022_program.to_account_info(),
+        token_b_program: a.token_program.to_account_info(),
+        event_authority: a.event_authority.to_account_info(),
+        program: a.meteora_program.to_account_info(),
+    }
+    .invoke(&[seeds])?;
+    a.token_a_account.reload()?;
+    a.token_b_account.reload()?;
+    let delta_a = a
+        .token_a_account
+        .amount
+        .checked_sub(before_a)
+        .ok_or(LaunchpadError::AmountOverflow)?;
+    let delta_b = a
+        .token_b_account
+        .amount
+        .checked_sub(before_b)
+        .ok_or(LaunchpadError::AmountOverflow)?;
+    // Check actual token credits, not wallet lamports or pre-CPI pending fees.
+    // Returning an error rolls back the CPI, including rounded checkpoints and
+    // any ATA creations earlier in this transaction. Never close/unwrap here.
+    validate_payout(delta_a, delta_b, a.recipient.is_signer)
+}
+
+fn validate_payout(delta_a: u64, delta_b: u64, recipient_signed: bool) -> Result<()> {
+    require!(
+        delta_a > 0 || delta_b > 0,
+        LaunchpadError::MeteoraZeroPayout
+    );
+    // OnlyB pools pay exclusively in wSOL. Also require this quote-denominated
+    // floor for other modes: arbitrary units of token A cannot bypass it.
+    require!(
+        recipient_signed || delta_b >= MIN_PERMISSIONLESS_METEORA_CLAIM_LAMPORTS,
+        LaunchpadError::MeteoraClaimBelowMinimum
+    );
+    Ok(())
+}
+
diff --git a/programs/launchpad_program/src/instructions/create_or_buy_pda.rs b/programs/launchpad_program/src/instructions/create_or_buy_pda.rs
new file mode 100644
index 0000000..b48af09
--- /dev/null
+++ b/programs/launchpad_program/src/instructions/create_or_buy_pda.rs
@@ -0,0 +1,158 @@
+//! Additive PDA adapter: execute the unchanged live create/buy instructions.
+//! No existing account layout, fee rule, or legacy instruction is replaced.
+//! The mint commits to all launch parameters except the buyer's amount/slippage.
+//! This prevents another first buyer from substituting metadata or fee recipients.
+use anchor_lang::prelude::*;
+use anchor_lang::{InstructionData, solana_program::{hash::hash, instruction::{AccountMeta, Instruction}, program::invoke_signed}};
+use super::{CreateAndFirstBuyParams, BuyParams};
+
+#[derive(Accounts)]
+pub struct CreateOrBuyPda<'info> {
+    #[account(mut)]
+    pub buyer: Signer<'info>,
+    /// CHECK: attribution follows the unchanged live handler; not proof of consent.
+    pub creator: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    pub config: UncheckedAccount<'info>,
+    /// CHECK: exact terms-bound PDA is validated before either inner instruction.
+    #[account(mut)]
+    pub mint: UncheckedAccount<'info>,
+    /// CHECK: validated and initialized by the unchanged inner instruction.
+    #[account(mut)]
+    pub launched_coin: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    #[account(mut)]
+    pub vault_token_account: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    pub genie_alloc_vault_authority: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    #[account(mut)]
+    pub genie_alloc_vault_token_account: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    #[account(mut)]
+    pub buyer_token_account: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    #[account(mut)]
+    pub treasury: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    #[account(mut)]
+    pub creator_fee_recipient: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    #[account(mut)]
+    pub rewards_pool: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    #[account(mut)]
+    pub charity_wallet: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    pub token_program: UncheckedAccount<'info>,
+    /// CHECK: validated by the unchanged inner instruction.
+    pub associated_token_program: UncheckedAccount<'info>,
+    pub system_program: Program<'info, System>,
+    pub rent: Sysvar<'info, Rent>,
+    /// CHECK: self-CPI executable, fixed to this program.
+    #[account(address = crate::ID, executable)]
+    pub launchpad_program: UncheckedAccount<'info>,
+}
+
+/// Extra terms for a NEW paid PDA address. Existing PDA and keypair entrypoints
+/// retain their exact wire and semantics. The fee is paid only by the creating
+/// buyer, atomically with mint creation and purchase; racing normal buys do not
+/// pay it again. A caller cannot omit it while retaining the reserved address.
+#[derive(AnchorSerialize, AnchorDeserialize, Clone, Debug)]
+pub struct PdaVanityFee {
+    pub recipient: Pubkey,
+    pub lamports: u64,
+}
+
+pub(crate) fn handler<'info>(ctx: Context<'_, '_, '_, 'info, CreateOrBuyPda<'info>>, params: CreateAndFirstBuyParams, nonce: u64) -> Result<()> {
+    handler_internal(ctx, params, nonce, None)
+}
+
+pub(crate) fn handler_with_vanity_fee<'info>(ctx: Context<'_, '_, '_, 'info, CreateOrBuyPda<'info>>, params: CreateAndFirstBuyParams, nonce: u64, fee: PdaVanityFee) -> Result<()> {
+    require!(fee.lamports > 0, anchor_lang::error::ErrorCode::ConstraintRaw);
+    handler_internal(ctx, params, nonce, Some(fee))
+}
+
+fn handler_internal<'info>(ctx: Context<'_, '_, '_, 'info, CreateOrBuyPda<'info>>, params: CreateAndFirstBuyParams, nonce: u64, fee: Option<PdaVanityFee>) -> Result<()> {
+    let mut terms = params.clone();
+    terms.first_buy_sol_amount = 0;
+    terms.first_buy_min_tokens_out = 0;
+    let mut committed = terms.try_to_vec()?;
+    if let Some(ref fee) = fee {
+        committed.extend_from_slice(b"paid-vanity-v1");
+        committed.extend_from_slice(&fee.try_to_vec()?);
+    }
+    let digest = hash(&committed);
+    let creator = ctx.accounts.creator.key();
+    let nonce_bytes = nonce.to_le_bytes();
+    let seeds = [b"mint".as_ref(), creator.as_ref(), nonce_bytes.as_ref(), digest.as_ref()];
+    let (mint, bump) = Pubkey::find_program_address(&seeds, &crate::ID);
+    require_keys_eq!(ctx.accounts.mint.key(), mint, anchor_lang::error::ErrorCode::ConstraintSeeds);
+    let mut infos = ctx.accounts.to_account_infos();
+    infos.extend_from_slice(ctx.remaining_accounts);
+    // Existing coin accounts serialize conflicting first buys on the runtime's
+    // write lock. Only the winner creates; a later execution uses ordinary buy.
+    // Invalid/partial state is rejected by the existing account constraints.
+    let creating = ctx.accounts.launched_coin.data_is_empty();
+    let (indices, data): (Vec<usize>, Vec<u8>) = if creating {
+        ((0..17).collect(), crate::instruction::CreateAndFirstBuy { params }.data())
+    } else {
+        (vec![0, 2, 4, 3, 5, 8, 9, 10, 11, 12, 13, 14, 15],
+         crate::instruction::Buy { params: BuyParams { sol_in: params.first_buy_sol_amount, min_tokens_out: params.first_buy_min_tokens_out } }.data())
+    };
+    let bump_bytes = [bump];
+    let signer = [b"mint".as_ref(), creator.as_ref(), nonce_bytes.as_ref(), digest.as_ref(), bump_bytes.as_ref()];
+    if creating && ctx.accounts.mint.lamports() > 0 {
+        // A public PDA can receive unsolicited SOL before first buy. Return
+        // that donation to the rent payer so the unchanged create_account CPI
+        // can allocate it; never sweep an allocated or foreign-owned account.
+        require_keys_eq!(*ctx.accounts.mint.owner, anchor_lang::system_program::ID, anchor_lang::error::ErrorCode::ConstraintOwner);
+        require!(ctx.accounts.mint.data_is_empty(), anchor_lang::error::ErrorCode::ConstraintZero);
+        anchor_lang::system_program::transfer(
+            CpiContext::new_with_signer(ctx.accounts.system_program.to_account_info(),
+                anchor_lang::system_program::Transfer { from: ctx.accounts.mint.to_account_info(), to: ctx.accounts.buyer.to_account_info() }, &[&signer]),
+            ctx.accounts.mint.lamports(),
+        )?;
+    }
+    let mut accounts: Vec<AccountMeta> = indices.iter().map(|&i| {
+        let a = &infos[i];
+        AccountMeta { pubkey: *a.key, is_writable: a.is_writable,
+            is_signer: a.is_signer || (creating && i == 3) }
+    }).collect();
+    accounts.extend(ctx.remaining_accounts.iter().map(|a| AccountMeta { pubkey: *a.key, is_writable: a.is_writable, is_signer: a.is_signer }));
+    let ix = Instruction { program_id: crate::ID, accounts, data };
+    invoke_signed(&ix, &infos, &[&signer])?;
+    if creating {
+        if let Some(fee) = fee {
+            let recipient = ctx.remaining_accounts.iter().find(|a| a.key() == fee.recipient)
+                .ok_or(anchor_lang::error::ErrorCode::AccountNotEnoughKeys)?;
+            require!(recipient.is_writable, anchor_lang::error::ErrorCode::ConstraintMut);
+            require_keys_eq!(*recipient.owner, anchor_lang::system_program::ID, anchor_lang::error::ErrorCode::ConstraintOwner);
+            require!(recipient.data_is_empty(), anchor_lang::error::ErrorCode::ConstraintZero);
+            anchor_lang::system_program::transfer(
+                CpiContext::new(ctx.accounts.system_program.to_account_info(), anchor_lang::system_program::Transfer {
+                    from: ctx.accounts.buyer.to_account_info(), to: recipient.clone(),
+                }), fee.lamports,
+            )?;
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod paid_terms_tests {
+    use super::*;
+    #[test]
+    fn paid_commitment_cannot_be_substituted_or_confused_with_unpaid_terms() {
+        let terms = b"canonical serialized launch terms";
+        let fee = PdaVanityFee { recipient: Pubkey::new_unique(), lamports: 50_000_000 };
+        let commit = |fee: &PdaVanityFee| {
+            let mut bytes = terms.to_vec(); bytes.extend_from_slice(b"paid-vanity-v1");
+            bytes.extend_from_slice(&fee.try_to_vec().unwrap()); hash(&bytes)
+        };
+        assert_ne!(commit(&fee), hash(terms));
+        assert_ne!(commit(&fee), commit(&PdaVanityFee { recipient: Pubkey::new_unique(), ..fee.clone() }));
+        assert_ne!(commit(&fee), commit(&PdaVanityFee { lamports: fee.lamports - 1, ..fee.clone() }));
+        assert_eq!(fee.try_to_vec().unwrap().len(), 40);
+    }
+}
diff --git a/programs/launchpad_program/src/instructions/creator_pull.rs b/programs/launchpad_program/src/instructions/creator_pull.rs
